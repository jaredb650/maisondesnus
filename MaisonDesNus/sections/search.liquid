<section class="search-page">
  <header class="search-page__header">
    <h1>Search</h1>
  </header>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input type="hidden" name="type" value="product">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off" autofocus>
    <button type="submit">Enter</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="search-page__empty font-italic">No results for &ldquo;{{ search.terms }}&rdquo;.</p>
    {%- else -%}
      <p class="search-page__count label-text">{{ search.results_count }} {{ search.results_count | pluralize: 'Result', 'Results' }}</p>

      {%- paginate search.results by 20 -%}
        <div class="product-grid">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'product-card', product: result -%}
            {%- else -%}
              <a href="{{ result.url }}" class="search-page__result-generic">
                <span class="font-italic">{{ result.title }}</span>
                <span class="label-text">{{ result.object_type | capitalize }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="search-page__pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
  .search-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px var(--page-margin) 96px;
  }
  .search-page__header {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 24px;
  }
  .search-page__form {
    max-width: 720px;
    margin: 0 auto 48px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--color-foreground);
    border-radius: var(--radius-pill);
    padding: 4px 6px 4px 20px;
    height: 44px;
  }
  .search-page__form input[type="search"] {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-nav);
    font-size: var(--fs-body);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .search-page__form button {
    padding: 6px 14px;
    font-family: var(--font-nav);
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
  }
  .search-page__empty {
    text-align: center;
    font-size: 22px;
    padding: 48px 0;
  }
  .search-page__count {
    text-align: center;
    color: var(--color-muted);
    margin-bottom: 32px;
  }
  .search-page__result-generic {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    aspect-ratio: 4 / 5;
    background: var(--color-background-alt);
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .search-page__result-generic .font-italic { font-size: 18px; }
  .search-page__pagination {
    text-align: center;
    padding: 48px 0;
    font-family: var(--font-nav);
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
  }

  /* shared grid pattern */
  .search-page .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 899px) {
    .search-page .product-grid { grid-template-columns: repeat(2, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
