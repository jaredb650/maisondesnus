<section class="cart-page">
  <header class="cart-page__header">
    <h1>Bag</h1>
    <span class="cart-page__count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</span>
  </header>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      <div class="cart-page__items">
        {%- for item in cart.items -%}
          <div class="cart-page__item">
            <div class="cart-page__item-media">
              {%- if item.image -%}
                <a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}</a>
              {%- endif -%}
            </div>
            <div class="cart-page__item-info">
              <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-page__item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-page__item-qty">
                <a href="{{ item.url_to_remove }}" aria-label="Decrease">−</a>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                <a href="{{ item.url_change | default: item.url }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Increase">+</a>
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-page__item-remove">Remove</a>
            </div>
            <div class="cart-page__item-price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-page__summary">
        <div class="cart-page__note">
          <label for="cart-note" class="label-text">Gift / Message</label>
          <textarea id="cart-note" name="note" placeholder="Add a note (optional)">{{ cart.note }}</textarea>
        </div>
        <div class="cart-page__totals">
          <div class="cart-page__subtotal-row">
            <span class="label-text">Subtotal</span>
            <span class="cart-page__subtotal">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-page__shipping-note">Shipping and taxes calculated at checkout.</p>
          <div class="cart-page__actions">
            <button type="submit" name="update" class="btn btn--outline">Update</button>
            <button type="submit" name="checkout" class="btn btn--primary">Checkout</button>
          </div>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="cart-page__empty">
      <p class="font-italic">Your bag is empty.</p>
      <a href="/collections/all" class="btn btn--outline btn--pill">Shop Now</a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .cart-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 48px var(--page-margin) 96px;
  }
  .cart-page__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 24px;
  }
  .cart-page__count {
    font-family: var(--font-nav);
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cart-page__items { border-top: 1px solid var(--color-border); }
  .cart-page__item {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
  }
  .cart-page__item-title {
    font-family: var(--font-nav);
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    font-weight: 500;
  }
  .cart-page__item-variant {
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
    margin-top: 4px;
  }
  .cart-page__item-qty {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--color-border);
    padding: 6px 10px;
  }
  .cart-page__item-qty a { color: var(--color-muted); }
  .cart-page__item-qty input {
    width: 32px;
    text-align: center;
    border: none;
    background: none;
    font: inherit;
  }
  .cart-page__item-remove {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-nav);
    font-size: 10px;
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cart-page__item-price {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-body);
  }

  .cart-page__summary {
    margin-top: 32px;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cart-page__note { flex: 1; min-width: 260px; }
  .cart-page__note textarea {
    display: block;
    width: 100%;
    min-height: 80px;
    margin-top: 8px;
    border: 1px solid var(--color-border);
    padding: 10px;
    background: var(--color-background);
    font: inherit;
    font-size: var(--fs-body);
  }
  .cart-page__totals { min-width: 280px; text-align: right; }
  .cart-page__subtotal-row {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 4px;
  }
  .cart-page__subtotal {
    font-family: var(--font-italic);
    font-style: italic;
    font-size: 24px;
    font-variant-numeric: tabular-nums;
  }
  .cart-page__shipping-note {
    font-size: 11px;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .cart-page__actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .cart-page__empty {
    text-align: center;
    padding: 80px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .cart-page__empty .font-italic { font-size: 22px; }

  @media (max-width: 599px) {
    .cart-page__item { grid-template-columns: 80px 1fr; }
    .cart-page__item-price { grid-column: 1 / -1; text-align: right; }
    .cart-page__summary { flex-direction: column; }
    .cart-page__totals { text-align: left; }
    .cart-page__actions { justify-content: flex-start; flex-wrap: wrap; }
  }
{% endstylesheet %}

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
