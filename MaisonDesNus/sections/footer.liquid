<footer class="site-footer">
  <div class="site-footer__grid">
    {%- for block in section.blocks -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">{{ block.settings.heading }}</h4>
        <ul class="site-footer__links">
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign lines = block.settings.fallback_links | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- if parts.size > 0 and parts[0] != blank -%}
                <li><a href="{{ parts[1] | default: '#' | strip }}">{{ parts[0] | strip }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}

    <div class="site-footer__col site-footer__newsletter">
      <h4 class="site-footer__heading">Newsletter</h4>
      <div class="site-footer__newsletter-body">
        <p class="site-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', id: 'newsletter-footer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <input type="email" name="contact[email]" placeholder="Email" required aria-label="Email address">
            <button type="submit" aria-label="Subscribe">Enter</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} Maison des Nus · New York, NY</span>
    {%- if section.settings.show_payment_icons -%}
      <div class="site-footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    width: 100%;
    padding: 112px var(--page-margin) 20px;
    font-family: var(--font-nav);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(28px, 5vw, 72px);
    max-width: 1180px;
    margin: 0 auto;
    padding-bottom: 72px;
  }
  .site-footer__col {
    display: grid;
    grid-template-columns: minmax(64px, auto) 1fr;
    gap: 18px;
    align-items: start;
  }
  .site-footer__heading {
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.3;
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-nav);
    line-height: 1.3;
  }
  .site-footer__links a { color: var(--color-foreground); }
  .site-footer__links a:hover { opacity: 0.6; }

  .site-footer__newsletter {
    align-items: start;
  }
  .site-footer__newsletter-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .site-footer__newsletter-text {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-muted);
  }
  .site-footer__newsletter-form {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-foreground);
    border-radius: var(--radius-pill);
    padding: 0 4px 0 14px;
    height: 28px;
  }
  .site-footer__newsletter-form input[type="email"] {
    flex: 1;
    border: 0;
    background: transparent;
    outline: none;
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    min-width: 0;
  }
  .site-footer__newsletter-form button {
    padding: 4px 12px;
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    max-width: 1180px;
    margin: 0 auto;
    padding-top: 16px;
    flex-wrap: wrap;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
  }
  .site-footer__payment { display: flex; gap: 6px; }
  .site-footer__payment svg { height: 14px; }
  .site-footer__bottom > span::before {
    content: '';
    display: block;
    width: 200px;
    height: 2px;
    background: currentColor;
    margin-bottom: 6px;
  }

  @media (max-width: 899px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 599px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter blurb",
      "default": "Sign up for updates on new arrivals and editorials." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Company" },
        { "type": "link_list", "id": "menu", "label": "Menu (optional)" },
        { "type": "textarea", "id": "fallback_links", "label": "Fallback links (title|url per line)",
          "default": "About|/pages/about\nPress|/pages/press\nCareers|/pages/careers\nContact|/pages/contact" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "The Company",
            "fallback_links": "About|/pages/about\nPress|/pages/press\nCareers|/pages/careers\nContact|/pages/contact\nAccessibility|/pages/accessibility"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Customer Care",
            "fallback_links": "Shipping|/pages/shipping\nReturns|/pages/returns\nSize Guide|/pages/size-guide\nCustom Orders|/pages/custom-orders\nGift Cards|/pages/gift-card\nFAQ|/pages/faq"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Follow",
            "fallback_links": "Instagram|https://instagram.com\nTikTok|https://tiktok.com\nPinterest|https://pinterest.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}
