<div class="page {% if section.settings.narrow %}page--narrow{% endif %}">
  <header class="page__header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="page__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="page__title">{{ page.title }}</h1>
  </header>
  <div class="page__body rte">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Script eyebrow", "default": "from the house" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow content width", "default": true }
  ]
}
{% endschema %}
