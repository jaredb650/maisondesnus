{%- liquid
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
  assign is_split = false
  if section.settings.layout == 'split'
    assign is_split = true
  endif
-%}

<section class="hero hero--{{ section.settings.layout }}" data-hero>
  <div class="hero__media">
    {%- if is_split -%}
      <div class="hero__slot">
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 1600 | image_tag:
              class: 'hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '600,900,1200,1600',
              alt: section.settings.image_alt_1 | default: shop.name
          }}
        {%- else -%}
          <img src="{{ 'hero-1.jpg' | asset_url }}" alt="{{ shop.name }}" class="hero__image" loading="eager" fetchpriority="high" width="1600" height="2000">
        {%- endif -%}
      </div>
      <div class="hero__slot hero__slot--secondary">
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 1600 | image_tag:
              class: 'hero__image',
              loading: 'eager',
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '600,900,1200,1600',
              alt: section.settings.image_alt_2 | default: shop.name
          }}
        {%- else -%}
          <img src="{{ 'hero-2.jpg' | asset_url }}" alt="{{ shop.name }}" class="hero__image" loading="eager" width="1600" height="2000">
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="hero__slot hero__slot--full">
        {%- if has_video -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero__video', loading: 'eager' }}
        {%- elsif section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 2400 | image_tag:
              class: 'hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '600,900,1200,1600,2000,2400',
              alt: section.settings.image_alt_1 | default: shop.name
          }}
        {%- else -%}
          <img src="{{ 'hero-1.jpg' | asset_url }}" alt="{{ shop.name }}" class="hero__image" loading="eager" fetchpriority="high" width="2400" height="3000">
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_overlay -%}
      <div class="hero__overlay">
        {%- if section.settings.overlay_title != blank -%}
          <h1 class="hero__title">{{ section.settings.overlay_title }}</h1>
        {%- endif -%}
        <div class="hero__cta">
          {%- if section.settings.cta_1_text != blank -%}
            <a href="{{ section.settings.cta_1_url | default: '/collections/all' }}" class="btn btn--primary btn--pill">
              {{ section.settings.cta_1_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_2_text != blank -%}
            <a href="{{ section.settings.cta_2_url | default: '/pages/custom-orders' }}" class="btn btn--outline btn--pill">
              {{ section.settings.cta_2_text }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    width: 100%;
    background-color: var(--color-background);
    position: relative;
  }
  .hero__media {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .hero--split .hero__media {
    grid-template-columns: 1fr 1fr;
  }
  .hero__slot {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-background-alt);
  }
  @media (min-width: 900px) {
    .hero--split .hero__slot {
      aspect-ratio: auto;
      height: calc(100svh - var(--header-height) - (var(--announcement-height) * 2));
      min-height: 560px;
    }
  }
  .hero__slot--full { aspect-ratio: auto; height: calc(100svh - var(--header-height)); min-height: 520px; }
  .hero__image,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 320px;
    font-family: var(--font-nav);
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 48px var(--page-margin);
    pointer-events: none;
    text-align: center;
    gap: 20px;
  }
  .hero__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(28px, 5vw, 64px);
    letter-spacing: 0.02em;
    color: var(--color-background);
    max-width: 20ch;
    text-shadow: 0 2px 16px rgba(0,0,0,0.25);
  }
  .hero__cta {
    display: flex;
    gap: 12px;
    pointer-events: auto;
  }

  @media (max-width: 899px) {
    .hero--split .hero__media { grid-template-columns: 1fr; }
    .hero--split .hero__slot--secondary { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split (two images side by side)" },
        { "value": "full", "label": "Full width (single media)" }
      ],
      "default": "split"
    },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (primary)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (split layout — hidden on mobile)" },
    { "type": "video", "id": "video", "label": "Video (full layout only, overrides Image 1)" },
    { "type": "text", "id": "image_alt_1", "label": "Image 1 alt text" },
    { "type": "text", "id": "image_alt_2", "label": "Image 2 alt text" },
    { "type": "header", "content": "Overlay (optional)" },
    { "type": "checkbox", "id": "show_overlay", "label": "Show overlay", "default": false },
    { "type": "text", "id": "overlay_title", "label": "Title" },
    { "type": "text", "id": "cta_1_text", "label": "Button 1 text" },
    { "type": "url", "id": "cta_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "cta_2_text", "label": "Button 2 text" },
    { "type": "url", "id": "cta_2_url", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero", "settings": { "layout": "split" } }]
}
{% endschema %}
