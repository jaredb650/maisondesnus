<section class="page-hero {% if section.settings.narrow %}page-hero--narrow{% endif %}">
  <header class="page-hero__header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="page-hero__eyebrow label-text">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="page-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}
  </header>
  {%- if section.settings.body != blank -%}
    <div class="page-hero__body">{{ section.settings.body }}</div>
  {%- endif -%}
</section>

{% stylesheet %}
  .page-hero {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 64px var(--page-margin) 48px;
  }
  .page-hero--narrow { max-width: 880px; }
  .page-hero__header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 32px;
  }
  .page-hero__eyebrow {
    color: var(--color-muted);
  }
  .page-hero__title {
    font-size: clamp(28px, 4vw, 44px);
  }
  .page-hero__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .page-hero__body p + p { margin-top: 12px; }
  .page-hero__body h2 {
    margin-top: 24px;
    margin-bottom: 8px;
    font-size: 16px;
  }
  .page-hero__body a { border-bottom: 1px solid currentColor; }
{% endstylesheet %}

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small caps)" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow", "default": true }
  ],
  "presets": [{ "name": "Page Hero" }]
}
{% endschema %}
